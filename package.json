{
  "name": "fws-prismia",
  "version": "1.0.0",
  "description": "FWS Prismia — independent WebGL shader engine, material presets and studio",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.js",
    "./presets": "./src/presets/index.js",
    "./lighting": "./src/lighting/index.js",
    "./package.json": "./package.json",
    "./scopes": "./api/scopes.js",
    "./shaders": "./src/index.js",
    "./graph": "./api/graph.js",
    "./materials": "./api/materials.js",
    "./studio": "./api/studio.js",
    "./styles.css": "./src/web/designer.css"
  },
  "files": [
    "api/",
    "src/",
    "README.md",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:studio": "node tests/designer.browser.cjs && node tests/surface.browser.cjs",
    "test:viewport3d": "node tests/viewport3d.browser.cjs && node tests/viewport-discovery.browser.cjs && node tests/framework-viewport.browser.cjs",
    "test:graphics": "node tests/graphics.browser.cjs"
  },
  "peerDependencies": {
    "three": ">=0.186.1 <0.188.0"
  },
  "devDependencies": {
    "framework-preparatorio": "git+https://github.com/Kilyakus/framework-preparatorio.git",
    "playwright": "1.57.0",
    "three": "0.186.1",
    "vite": "6.4.6",
    "vite-plugin-singlefile": "2.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "uix-preparatorio": "git+https://github.com/Kilyakus/uix-preparatorio.git"
  },
  "peerDependenciesMeta": {
    "framework-preparatorio": {
      "optional": true
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
